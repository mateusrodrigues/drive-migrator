<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DriveMigrator.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BannerErrorBrush" Color="#FDE7E9" />
          <SolidColorBrush x:Key="BannerWarningBrush" Color="#FFF4CE" />
          <SolidColorBrush x:Key="BannerInfoBrush" Color="#EAF1FB" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0F7B0F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BannerErrorBrush" Color="#442726" />
          <SolidColorBrush x:Key="BannerWarningBrush" Color="#433519" />
          <SolidColorBrush x:Key="BannerInfoBrush" Color="#2B3340" />
          <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6CCB5F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
