<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DriveMigrator.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <ResourceInclude Source="/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <!-- accent-100 and surface-100, for the few stock visuals left untouched (scroll bars, text selection). -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2952CC" RegionColor="#F6F7F9" ErrorText="#B3261E" />
        <ColorPaletteResources x:Key="Dark" Accent="#7096F7" RegionColor="#0F1319" ErrorText="#FF8570" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
