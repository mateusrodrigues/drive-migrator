<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DriveMigrator.App.ViewModels"
             xmlns:ctl="using:DriveMigrator.App.Controls"
             x:Class="DriveMigrator.App.Views.PaneView"
             x:DataType="vm:PaneViewModel">
  <UserControl.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <!-- Placeholder rows (loading, truncated, error) are italic; an error is also danger-toned. -->
    <Style Selector="TextBlock.placeholder">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource ink-200}" />
    </Style>
    <Style Selector="TextBlock.placeholder.error">
      <Setter Property="Foreground" Value="{DynamicResource danger-100}" />
    </Style>
  </UserControl.Styles>

  <Border CornerRadius="{StaticResource radius-lg}" BorderThickness="1" ClipToBounds="True"
          BorderBrush="{DynamicResource border-100}" Background="{DynamicResource surface-200}">
    <DockPanel>
      <!-- AccountPicker, with refresh beside it rather than inside it. -->
      <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{DynamicResource border-100}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox Classes="account" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                    PlaceholderText="{Binding AccountPlaceholder}" IsEnabled="{Binding HasAnyAccounts}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountOptionViewModel">
                <StackPanel Spacing="1">
                  <TextBlock Classes="body-strong" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                  <TextBlock Classes="body-sm muted" TextTrimming="CharacterEllipsis" Text="{Binding Email}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Classes="icon" Command="{Binding RefreshCommand}" IsEnabled="{Binding HasAccount}"
                  ToolTip.Tip="Reload this account's folders">
            <ctl:Icon Kind="Refresh" />
          </Button>
        </Grid>
      </Border>

      <!-- What's checked here, and where copies into this pane land. -->
      <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{DynamicResource border-100}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="2">
          <TextBlock Classes="body-sm" Text="{Binding SelectionSummary}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="body-sm muted" Text="{Binding DestinationSummary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <Panel Background="{DynamicResource surface-300}">
        <TextBlock Classes="body muted" Margin="32" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasAnyAccounts}"
                   Text="Connect accounts in Settings to browse them here." />
        <TreeView Padding="4" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}" IsVisible="{Binding HasAccount}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Panel Width="16">
                  <CheckBox Classes="node" IsThreeState="False" IsChecked="{Binding IsChecked}" IsVisible="{Binding !IsPlaceholder}" />
                </Panel>
                <ctl:Icon Classes="muted" Kind="{Binding Icon}" IsVisible="{Binding !IsPlaceholder}" />
                <ctl:Icon Classes="danger" Kind="Danger" IsVisible="{Binding IsError}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}"
                           Classes.placeholder="{Binding IsPlaceholder}" Classes.error="{Binding IsError}" />
                <TextBlock Classes="body-sm muted" VerticalAlignment="Center" Text="{Binding Detail}" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
