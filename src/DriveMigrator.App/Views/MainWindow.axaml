<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DriveMigrator.App.ViewModels"
        x:Class="DriveMigrator.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Drive Migrator"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500">
  <Grid Margin="16" RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="Drive Migrator" />
    <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding Status}" />
  </Grid>
</Window>
