<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DriveMigrator.App.ViewModels"
        xmlns:views="using:DriveMigrator.App.Views"
        xmlns:ctl="using:DriveMigrator.App.Controls"
        x:Class="DriveMigrator.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Drive Migrator"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500">
  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top" Height="44" Padding="16,0"
            Background="{DynamicResource surface-200}"
            BorderBrush="{DynamicResource border-100}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="title" VerticalAlignment="Center" Text="Drive Migrator" />
        <Button Grid.Column="1" Classes="secondary" Content="Settings" Command="{Binding OpenSettingsCommand}" />
      </Grid>
    </Border>

    <!-- Status: warning when an account needs attention, otherwise neutral information. -->
    <Panel DockPanel.Dock="Top" Margin="16,8,16,0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Border Classes="banner warning" IsVisible="{Binding NeedsAttention}">
        <DockPanel>
          <ctl:Icon Classes="tone warning" Kind="Warning" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
        </DockPanel>
      </Border>
      <Border Classes="banner info" IsVisible="{Binding ShowInfo}">
        <DockPanel>
          <ctl:Icon Classes="tone info" Kind="Info" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
        </DockPanel>
      </Border>
    </Panel>

    <!-- Transfers: only once a job exists. -->
    <Border DockPanel.Dock="Bottom" MaxHeight="220"
            Background="{DynamicResource surface-100}"
            BorderBrush="{DynamicResource border-100}" BorderThickness="0,1,0,0"
            IsVisible="{Binding Transfers.HasJobs}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="label muted" Margin="16,8" Text="Transfers" />
        <ScrollViewer Padding="16,0,16,12">
          <ItemsControl ItemsSource="{Binding Transfers.Jobs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TransferJobViewModel">
                <views:TransferJobRow />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The two panes around a fixed arrow column. -->
    <Grid ColumnDefinitions="*,36,*" ColumnSpacing="8" Margin="8">
      <views:PaneView Grid.Column="0" DataContext="{Binding Left}" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                  IsEnabled="{Binding Left.HasAnyAccounts}">
        <Button Classes="icon" Command="{Binding CopyLeftToRightCommand}"
                ToolTip.Tip="Copy checked items from the left pane into the right pane (you'll see the options first)">
          <ctl:Icon Kind="ArrowRight" />
        </Button>
        <Button Classes="icon" Command="{Binding CopyRightToLeftCommand}"
                ToolTip.Tip="Copy checked items from the right pane into the left pane (you'll see the options first)">
          <ctl:Icon Kind="ArrowLeft" />
        </Button>
      </StackPanel>

      <views:PaneView Grid.Column="2" DataContext="{Binding Right}" />
    </Grid>
  </DockPanel>
</Window>
